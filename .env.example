# Copiá este archivo a .env para desarrollo local. En Vercel, cargá las mismas
# variables en Project Settings → Environment Variables.

# Link a la app de reservas y pago (obligatorio; el build falla si falta o no es una URL).
PUBLIC_BOOKING_URL=https://webapp.siguefit.com/

# URL pública del sitio: define canonical, hreflang, Open Graph y sitemap.
# En Vercel puede quedar vacía: se usa el dominio de producción del proyecto.
PUBLIC_SITE_URL=http://localhost:4321

# Dirección de la API del sistema de reservas (panel /admin y portal /cuenta).
# En desarrollo: http://localhost:3000. En producción: https://api.studio124.com.ar
PUBLIC_API_URL=http://localhost:3000
