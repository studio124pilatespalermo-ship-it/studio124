---
import { studio } from "../content/studio";
import { interpolate, type Dictionary } from "../i18n";
import type { Locale } from "../i18n/locales";
import { formatDays } from "../lib/format";
import { whatsappUrl } from "../lib/urls";
import Logo from "./brand/Logo.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Container from "./ui/Container.astro";
import ExternalLink from "./ui/ExternalLink.astro";
import Text from "./ui/Text.astro";

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
const { street, neighborhood, city, betweenStreets } = studio.address;
const between = betweenStreets ? interpolate(dict.location.between, { a: betweenStreets[0], b: betweenStreets[1] }) : null;
const hint = dict.a11y.opensInNewTab;
const social = [
  { href: studio.links.instagram, label: dict.footer.instagram },
  { href: studio.links.facebook, label: dict.footer.facebook },
  { href: studio.links.googleReviews, label: dict.footer.reviews },
];
const titleClass = "font-sans text-[0.6875rem] font-semibold tracking-[0.2em] uppercase text-stone-text";
---

<footer class="bg-bone pt-16 pb-10 md:pt-20">
  <Container>
    <div class="grid gap-10 border-b border-stone/40 pb-12 md:grid-cols-[1.2fr_1fr_1fr_1fr]">
      <Logo variant="on-light" label={studio.name} class="h-20 w-auto md:h-24" />

      <div>
        <h2 class={titleClass}>{dict.footer.addressTitle}</h2>
        <address class="mt-3 text-sm leading-relaxed not-italic">
          <Text text={street} /><br />
          {between && <>{between}<br /></>}
          {neighborhood}, {city}
        </address>
      </div>

      <div>
        <h2 class={titleClass}>{dict.footer.hoursTitle}</h2>
        <dl class="mt-3 space-y-2 text-sm">
          {
            studio.openingHours.map((entry) => (
              <div>
                <dt class="text-stone-text">{formatDays(entry.days, dict)}</dt>
                <dd class="tabular-nums">
                  <Text text={interpolate(dict.footer.hoursRange, { opens: entry.opens, closes: entry.closes })} />
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div>
        <h2 class={titleClass}>{dict.footer.followTitle}</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {
            social.map((link) => (
              <li>
                <ExternalLink href={link.href} newTabHint={hint} class="text-link">
                  {link.label}
                </ExternalLink>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-6 pt-8 text-xs text-stone-text md:flex-row md:items-center md:justify-between">
      <p>
        {dict.footer.help}{" "}
        <ExternalLink href={whatsappUrl(studio.whatsappNumber)} newTabHint={hint} class="text-link">
          {dict.footer.whatsapp}
        </ExternalLink>{" "}
        {dict.footer.emailLabel} <a href={`mailto:${studio.email}`} class="text-link whitespace-nowrap">{studio.email}</a>
      </p>
      <LanguageSwitcher current={locale} label={dict.a11y.languageNav} class="-ml-1.5 text-ink" />
      <p>&copy; {new Date().getFullYear()} {studio.name}. {dict.footer.rights}</p>
    </div>
  </Container>
</footer>
