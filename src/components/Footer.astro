---
import { Image } from "astro:assets";
import { footerBackground } from "../content/photos";
import { studio } from "../content/studio";
import { interpolate, type Dictionary } from "../i18n";
import type { Locale } from "../i18n/locales";
import { formatClock, formatDays, formatPhone } from "../lib/format";
import { instagramHandle, whatsappUrl } from "../lib/urls";
import { LOGO_FIGURE_PATH } from "./brand/logo-paths";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Container from "./ui/Container.astro";
import ExternalLink from "./ui/ExternalLink.astro";
import Text from "./ui/Text.astro";

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
const { street, betweenStreets } = studio.address;
const between = betweenStreets
  ? interpolate(dict.footer.betweenStreets, { a: betweenStreets[0], b: betweenStreets[1] })
  : "";
const hint = dict.a11y.opensInNewTab;
const hours = studio.openingHours.map((entry) => ({
  // "Lunes a Viernes" sale de los nombres de los días; "Sábados", del texto del cliente.
  days: entry.days.length === 1 && entry.days[0] === "sat" ? dict.footer.saturday : formatDays(entry.days, dict),
  range: interpolate(dict.footer.hoursRange, { opens: formatClock(entry.opens), closes: formatClock(entry.closes) }),
}));
---

<footer>
  {/*
    Mockup: el pie es una foto a todo el ancho con los datos en crema a la izquierda.
    El velo del 80 % deja el texto en 5.9:1 contra el píxel más claro de la foto.
  */}
  <div class="on-dark relative isolate overflow-hidden bg-ink text-cream">
    <Image
      src={footerBackground}
      alt=""
      aria-hidden="true"
      widths={[768, 1080]}
      sizes="100vw"
      class="absolute inset-0 z-0 h-full w-full object-cover object-[50%_42%]"
    />
    <div
      aria-hidden="true"
      class="absolute inset-0 z-10 bg-ink/80 md:bg-transparent md:bg-gradient-to-r md:from-ink/80 md:from-38% md:via-ink/35 md:via-60% md:to-transparent"
    >
    </div>

    <Container class="on-photo-text relative z-20 py-16 md:py-24">
      <div class="max-w-md">
        <p class="flex items-end gap-1.5 text-4xl leading-none font-bold">
          {studio.name}
          <svg aria-hidden="true" viewBox="13 13 705 703" class="mb-0.5 h-7 w-auto" fill="currentColor">
            <path d={LOGO_FIGURE_PATH}></path>
          </svg>
        </p>
        <p class="mt-1 text-xl font-bold tracking-[0.02em] uppercase">{dict.footer.neighbourhood}</p>

        <address class="mt-6 text-sm leading-relaxed not-italic">
          <p><Text text={street} /> {between}</p>
          <ul class="mt-5 space-y-0.5">
            <li>
              <ExternalLink href={whatsappUrl(studio.whatsappNumber)} newTabHint={hint} class="link-bold">
                {formatPhone(studio.whatsappNumber, "local")}
              </ExternalLink>
            </li>
            <li>
              <a href={`mailto:${studio.email}`} class="link-bold break-all">{studio.email}</a>
            </li>
            <li>
              <ExternalLink href={studio.links.instagram} newTabHint={hint} class="link-bold">
                {instagramHandle(studio.links.instagram)}
              </ExternalLink>
            </li>
          </ul>
        </address>

        <h2 class="mt-10 text-lg font-bold tracking-[0.02em] uppercase">{dict.footer.hoursTitle}</h2>
        <dl class="mt-4 space-y-4 text-sm">
          {
            hours.map((entry) => (
              <div>
                <dt class="font-semibold">{entry.days}</dt>
                <dd class="tabular-nums">
                  <Text text={entry.range} />
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-4 text-sm font-semibold">{dict.footer.sundayClosed}</p>
      </div>
    </Container>
  </div>

  {/* Franja de abajo (no está en el mockup): el selector de idioma y el © tienen que estar en algún lado. */}
  <div class="bg-cream py-6 text-xs">
    <Container class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <LanguageSwitcher current={locale} label={dict.a11y.languageNav} class="-ml-1.5" />
      <p>&copy; {new Date().getFullYear()} {studio.name}. {dict.footer.rights}</p>
    </Container>
  </div>
</footer>
