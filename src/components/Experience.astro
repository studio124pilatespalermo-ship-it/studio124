---
import { Image } from "astro:assets";
import mapImage from "../assets/map.png";
import collage from "../assets/photos/buenos-aires.jpg";
import { photos } from "../content/photos";
import { studio } from "../content/studio";
import type { Dictionary } from "../i18n";
import { richText, type TextPart } from "../lib/content";
import BookButton from "./ui/BookButton.astro";
import Container from "./ui/Container.astro";
import Pill from "./ui/Pill.astro";
import RichText from "./ui/RichText.astro";

interface Props {
  dict: Dictionary;
  /** Párrafos ya interpolados (duración, personas por clase). */
  body: readonly string[];
}

const { dict, body } = Astro.props;
const rich = (text: string): readonly TextPart[] => richText(text, dict.experience.places, studio.nearbyPlaces);
const paragraphs = body.map(rich);
---

{/*
  "The Experience" es el bloque distintivo del mockup: un panel a sangre con el collage de
  Buenos Aires de fondo, el mapa del barrio dibujado en blanco sobre la mitad izquierda y
  todo el texto alineado a la derecha, en crema. El collage y el mapa son decorativos: lo
  que cuentan ya está escrito al lado.
*/}
<section id="experiencia" aria-labelledby="experiencia-title" class="scroll-mt-4 bg-sand py-2 md:py-3">
  <Container width="full">
    <div
      class="on-dark relative isolate flex items-center overflow-hidden rounded-[1.75rem] bg-ink text-cream md:min-h-[38rem] md:rounded-[2.25rem] lg:min-h-[42rem]"
    >
      <Image
        src={collage}
        alt=""
        aria-hidden="true"
        widths={[768, 1200, 1600, 1920]}
        sizes="(min-width: 1280px) 1280px, 100vw"
        class="absolute inset-0 z-0 h-full w-full object-cover"
      />
      {/*
        Velo negro parejo, como una bajada de exposición de toda la foto (y no un gris que la
        apaga). El collage ya es oscuro de por sí, así que alcanza con un 20 %: conserva su
        color real (verdes, rosados, el atardecer) y el 99 % de los píxeles detrás del texto
        crema supera 5:1 de contraste (AA pide 4,5:1). Sobre los pocos reflejos más claros el
        texto lleva sombra (.on-photo-text).
      */}
      <div aria-hidden="true" class="absolute inset-0 z-10 bg-black/20"></div>
      {/*
        El mapa ya viene con las calles en blanco: acá es una trama sobre el collage. Mide dos
        tercios del alto del panel y arranca al 20 % desde arriba y al 6,5 % desde la izquierda,
        como en el mockup (con altura en % y no con ancho, así no crece más que el panel).
        El pin marca dónde está el estudio, justo en el centro.
      */}
      <div class="pointer-events-none absolute top-[20%] left-[6.5%] z-10 hidden aspect-square h-[68%] md:block">
        <img
          src={mapImage.src}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-contain"
        />
        <span aria-hidden="true" class="absolute top-1/2 left-1/2 flex -translate-x-1/2 -translate-y-full flex-col items-center">
          <Image
            src={photos.space1}
            alt=""
            width={120}
            height={120}
            class="size-14 rounded-full object-cover ring-[3px] ring-cream shadow-[0_6px_18px_rgb(0_0_0/0.55)] lg:size-16"
          />
          <span class="-mt-2 size-3.5 rotate-45 bg-cream shadow-[0_6px_14px_rgb(0_0_0/0.5)]"></span>
        </span>
      </div>

      <div class="on-photo-text relative z-20 w-full px-6 py-14 md:py-16 md:pr-14 md:pl-[48%] md:text-right">
        <p class="script -mb-2 text-[2.5rem] leading-[0.95] sm:text-5xl lg:-mb-4 lg:text-6xl">{dict.experience.script}</p>
        <h2 id="experiencia-title" class="text-2xl font-semibold tracking-[0.02em] uppercase sm:text-3xl lg:text-4xl">
          {dict.experience.title}
        </h2>
        <p class="mt-5 text-lg font-semibold md:text-xl">{dict.experience.lead}</p>
        <div class="mt-5 space-y-4 text-base leading-relaxed md:text-lg">
          {
            paragraphs.map((parts) => (
              <p>
                <RichText parts={parts} newTabHint={dict.a11y.opensInNewTab} />
              </p>
            ))
          }
        </div>
        <p class="mt-5 text-base font-semibold md:text-lg">{dict.experience.note}</p>

        <div class="mt-8 flex flex-wrap gap-3 md:justify-end">
          <BookButton label={dict.cta.book} variant="plain" size="lg" tone="on-photo" />
          <Pill
            href={studio.links.googleMaps}
            tone="on-photo"
            size="lg"
            variant="script"
            newTabHint={dict.a11y.opensInNewTab}
          >
            <svg aria-hidden="true" width="13" height="16" viewBox="0 0 12 15" fill="none" class="shrink-0">
              <path d="M6 14s5-4.6 5-8.5A5 5 0 0 0 1 5.5C1 9.4 6 14 6 14Z" stroke="currentColor" stroke-width="1.3"></path>
              <circle cx="6" cy="5.5" r="1.7" fill="currentColor"></circle>
            </svg>
            {dict.cta.directions}
          </Pill>
        </div>
      </div>
    </div>
  </Container>
</section>
