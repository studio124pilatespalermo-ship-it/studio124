---
import { Image } from "astro:assets";
import { heroVideoUrl } from "../content/media";
import { photos } from "../content/photos";
import type { Dictionary } from "../i18n";
import Container from "./ui/Container.astro";
import Pill from "./ui/Pill.astro";

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

{/*
  Hero según el mockup del cliente: el texto va suelto sobre la foto (sin recuadro), con el
  título alineado a la derecha arriba y los dos adelantos —la experiencia y las membresías—
  alineados a la izquierda abajo. El contraste lo dan el velo y `.on-photo-text`.

  Capas (de abajo hacia arriba): foto (se ve mientras carga el video y si se pide reducir
  movimiento) → video en loop → velo → texto.
*/}
<section aria-labelledby="hero-title" class="on-dark relative isolate flex min-h-[100svh] overflow-hidden bg-ink text-cream">
  <Image
    src={photos.hero}
    alt={dict.photos.hero}
    priority
    widths={[640, 960, 1200, 1600]}
    sizes="100vw"
    class="absolute inset-0 z-0 h-full w-full object-cover"
  />
  {
    heroVideoUrl && (
      <video
        data-hero-video
        src={heroVideoUrl}
        autoplay
        loop
        muted
        playsinline
        disablepictureinpicture
        aria-hidden="true"
        class="absolute inset-0 z-0 h-full w-full object-cover"
      />
    )
  }
  <div aria-hidden="true" class="hero-scrim absolute inset-0 z-10"></div>

  <Container class="on-photo-text relative z-20 flex flex-1 flex-col justify-between gap-10 pt-24 pb-[calc(6.5rem+env(safe-area-inset-bottom))] md:pt-32 md:pb-16">
    <div class="ml-auto max-w-[46rem] text-right">
      <h1 id="hero-title">
        <span class="script block text-[2.5rem] leading-[1.05] sm:text-5xl md:whitespace-nowrap lg:text-[4rem]">
          {dict.hero.titleScript}
        </span>
        {/* El mockup monta "resultados reales" sobre la cola de la caligráfica. */}
        <span class="-mt-1 block text-2xl font-semibold tracking-[0.01em] sm:text-3xl lg:text-[2.5rem] lg:-mt-3">
          {dict.hero.titlePlain}
        </span>
      </h1>
      <p class="mt-3 ml-auto max-w-sm text-base leading-relaxed md:text-lg">{dict.hero.lead}</p>
      <p class="eyebrow mt-4 ml-auto max-w-xs">{dict.hero.tagline}</p>
    </div>

    <div class="max-w-md space-y-7">
      <div>
        <p class="script text-[2.25rem] leading-none sm:text-5xl">{dict.hero.experienceScript}</p>
        <h2 class="mt-1 text-xl font-semibold tracking-[0.04em] uppercase sm:text-2xl">{dict.hero.experienceTitle}</h2>
        <p class="mt-3 text-base leading-relaxed md:text-lg">{dict.hero.experienceText}</p>
        <Pill href="#experiencia" tone="on-photo" size="lg" variant="script" class="mt-4">{dict.cta.info}</Pill>
      </div>
      <div>
        <h2 class="text-lg font-semibold tracking-[0.04em] uppercase sm:text-xl">{dict.hero.membershipTitle}</h2>
        <p class="mt-2 text-base leading-relaxed">{dict.hero.membershipText}</p>
        <Pill href="#membresias" tone="on-photo" variant="script" class="mt-4">{dict.cta.more}</Pill>
      </div>
    </div>
  </Container>

  {
    heroVideoUrl && (
      <button
        type="button"
        hidden
        data-hero-video-toggle
        data-state="playing"
        data-label-pause={dict.hero.pauseVideo}
        data-label-play={dict.hero.playVideo}
        aria-label={dict.hero.pauseVideo}
        class="hero-toggle absolute right-5 bottom-[calc(5.5rem+env(safe-area-inset-bottom))] z-20 grid size-10 place-items-center rounded-full border border-cream/50 text-cream transition-colors hover:bg-cream/15 md:right-10 md:bottom-10"
      >
        <svg class="icon-pause" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M2 1h3v10H2zM7 1h3v10H7z" fill="currentColor"></path>
        </svg>
        <svg class="icon-play" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M2.5 1l8 5-8 5z" fill="currentColor"></path>
        </svg>
      </button>
    )
  }
  {heroVideoUrl && <script is:inline src="/hero-video.js" defer />}
</section>
