---
import { Image } from "astro:assets";
import { closingBackground } from "../content/photos";
import type { Dictionary } from "../i18n";
import BookButton from "./ui/BookButton.astro";
import Container from "./ui/Container.astro";

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<section aria-labelledby="closing-title" class="on-dark relative isolate overflow-hidden py-24 text-center text-bone md:py-32">
  <Image
    src={closingBackground}
    alt=""
    widths={[640, 1280, 1920, 2400]}
    sizes="100vw"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
  />
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-ink/55"></div>
  <Container class="flex flex-col items-center">
    <h2 id="closing-title" class="section-title italic">{dict.closing.title}</h2>
    <p class="mt-5 max-w-lg leading-relaxed text-bone/90">{dict.closing.body}</p>
    <BookButton label={dict.cta.book} size="lg" class="mt-9" />
  </Container>
</section>
