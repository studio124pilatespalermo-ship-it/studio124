---
import type { Dictionary } from "../i18n";
import BookButton from "./ui/BookButton.astro";
import Container from "./ui/Container.astro";

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<section aria-labelledby="steps-title" class="bg-bone py-20 md:py-28">
  <Container>
    <p class="eyebrow">{dict.steps.eyebrow}</p>
    <h2 id="steps-title" class="section-title mt-6">{dict.steps.title}</h2>

    <ol class="mt-12 grid md:grid-cols-4">
      {
        dict.steps.items.map((step, index) => (
          <li class="grid grid-cols-[3.5rem_1fr] gap-x-4 border-t border-stone/40 py-7 md:block md:border-t-0 md:border-l md:px-7 md:py-2 md:first:border-l-0 md:first:pl-0">
            <span aria-hidden="true" class="font-serif text-6xl leading-[0.85] md:text-7xl">
              {index + 1}
            </span>
            <div>
              <h3 class="font-serif text-2xl md:mt-6">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-stone-text">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 flex flex-col gap-6 border-t border-stone/40 pt-8 md:mt-14 md:flex-row md:items-center md:justify-between">
      <p class="max-w-xl text-sm leading-relaxed text-stone-text">{dict.steps.note}</p>
      <BookButton label={dict.cta.book} />
    </div>
  </Container>
</section>
