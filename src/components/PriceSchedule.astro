---
import { Image } from "astro:assets";
import { photos } from "../content/photos";
import { studio } from "../content/studio";
import { interpolate, type Dictionary } from "../i18n";
import type { Locale } from "../i18n/locales";
import { LOCALE_META } from "../i18n/locales";
import { templateVars } from "../lib/content";
import { formatMoney } from "../lib/format";
import ClassSchedule from "./ClassSchedule.astro";
import BookButton from "./ui/BookButton.astro";
import Container from "./ui/Container.astro";
import Text from "./ui/Text.astro";

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
const price = formatMoney(studio.dropInPrice, LOCALE_META[locale].intl);
const duration = interpolate(dict.pricing.duration, templateVars(studio));
---

<section id="precio" aria-labelledby="pricing-title" class="bg-sand py-20 md:py-28">
  <Container class="grid gap-12 lg:grid-cols-[1.1fr_1fr_1fr] lg:items-center lg:gap-10">
    <div class="arch-corner -mx-5 aspect-[5/4] bg-bone md:mx-0 lg:aspect-[4/5]">
      <Image
        src={photos.detail}
        alt={dict.photos.detail}
        widths={[480, 720, 960, 1400]}
        sizes="(min-width: 1024px) 24rem, 100vw"
        class="h-full w-full object-cover"
      />
    </div>

    <div>
      <p class="eyebrow">{dict.pricing.eyebrow}</p>
      <h2 id="pricing-title" class="mt-6 font-serif text-3xl">{dict.pricing.title}</h2>
      <p class="mt-3 font-serif text-[3.75rem] leading-none">
        <Text text={price.text} />
      </p>
      <p class="mt-4 text-sm text-stone-text">{dict.pricing.priceNote}</p>
      <p class="mt-1 text-sm text-stone-text"><Text text={duration} /></p>
      <p class="mt-6 max-w-sm border-l border-stone/60 pl-4 text-sm leading-relaxed">{dict.pricing.availability}</p>
      <BookButton label={dict.cta.book} class="mt-8" />
    </div>

    <ClassSchedule dict={dict} schedule={studio.classSchedule} />
  </Container>
</section>
