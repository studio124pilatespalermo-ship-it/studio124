---
import { Image } from "astro:assets";
import { galleryPhotos, photos } from "../content/photos";
import type { Dictionary } from "../i18n";
import Container from "./ui/Container.astro";

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<section aria-labelledby="space-title" class="bg-bone py-20 md:py-28">
  <Container>
    <h2 id="space-title" class="section-title">{dict.space.title}</h2>
    <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_14rem] lg:items-center">
      <!-- Mobile: la primera foto a todo el ancho y las otras dos de a par. Desktop: tres arcos en fila. -->
      <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-5">
        {
          galleryPhotos.map((id, index) => (
            <li
              class:list={[
                "arch bg-sand",
                index === 0 ? "col-span-2 aspect-[4/5] md:col-span-1 md:aspect-[3/4]" : "aspect-[3/4]",
                index === 2 && "mt-10 md:mt-0",
              ]}
            >
              <Image
                src={photos[id]}
                alt={dict.photos[id]}
                widths={[360, 540, 800, 1200]}
                sizes={index === 0 ? "(min-width: 768px) 30vw, 100vw" : "(min-width: 768px) 30vw, 45vw"}
                class="h-full w-full object-cover"
              />
            </li>
          ))
        }
      </ul>
      <div>
        <p class="font-serif text-[1.75rem] leading-snug italic">{dict.space.caption}</p>
        <span aria-hidden="true" class="mt-5 block h-px w-10 bg-stone/70"></span>
      </div>
    </div>
  </Container>
</section>
