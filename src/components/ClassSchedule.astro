---
import type { ScheduleGroup } from "../content/studio";
import type { Dictionary } from "../i18n";
import { formatDays } from "../lib/format";
import Text from "./ui/Text.astro";

interface Props {
  dict: Dictionary;
  schedule: readonly ScheduleGroup[];
}

const { dict, schedule } = Astro.props;
---

<div class="rounded-[1.25rem] border border-stone/45 bg-bone/80 p-6 md:p-7">
  <h3 id="schedule-title" class="font-serif text-[1.75rem]">{dict.pricing.scheduleTitle}</h3>
  <dl class="mt-5" aria-labelledby="schedule-title">
    {
      schedule.map((group) => (
        <div class="border-t border-stone/30 py-4 first:border-t-0 first:pt-0 last:pb-0">
          <dt class="text-[0.6875rem] font-semibold tracking-[0.2em] uppercase text-stone-text">
            {formatDays(group.days, dict)}
          </dt>
          {group.times.map((time) => (
            <dd class="mt-2 mr-5 inline-block text-[0.9375rem] tabular-nums">
              <Text text={time} />
            </dd>
          ))}
        </div>
      ))
    }
  </dl>
</div>
