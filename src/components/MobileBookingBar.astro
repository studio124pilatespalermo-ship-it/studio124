---
import { studio } from "../content/studio";
import type { Dictionary } from "../i18n";
import { displayValue } from "../lib/placeholders";
import BookButton from "./ui/BookButton.astro";
import Text from "./ui/Text.astro";

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const duration = displayValue(studio.classDurationMinutes, "{{DURACION}}");
---

{/* Barra fija sólo en mobile: el botón de reserva queda siempre al alcance del pulgar. */}
<aside
  aria-label={dict.a11y.bookingBar}
  class="fixed inset-x-0 bottom-0 z-30 border-t border-stone/35 bg-cream px-5 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] md:hidden"
>
  <div class="flex items-center justify-between gap-4">
    <p class="min-w-0 leading-tight">
      <span class="block truncate text-base font-medium">{dict.method.title}</span>
      <span class="block text-xs text-stone-text">
        <Text text={`${duration.text} min`} />
      </span>
    </p>
    <BookButton label={dict.cta.bookShort} />
  </div>
</aside>
