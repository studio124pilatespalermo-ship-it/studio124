---
import type { Dictionary } from "../i18n";
import type { FaqEntry } from "../lib/content";
import Container from "./ui/Container.astro";
import Text from "./ui/Text.astro";

interface Props {
  dict: Dictionary;
  items: readonly FaqEntry[];
}

const { dict, items } = Astro.props;
---

<section aria-labelledby="faq-title" class="bg-sand py-20 md:py-28">
  <Container class="max-w-3xl">
    <h2 id="faq-title" class="section-title">{dict.faq.title}</h2>
    <div class="mt-10 space-y-3">
      {
        items.map((item) => (
          <details class="faq-item group rounded-xl border border-stone/45 bg-bone/80">
            <summary class="flex cursor-pointer items-center justify-between gap-6 rounded-xl px-5 py-4 text-[0.9375rem] font-medium md:px-6">
              <span>{item.question}</span>
              <svg
                aria-hidden="true"
                width="14"
                height="14"
                viewBox="0 0 14 14"
                fill="none"
                class="shrink-0 text-stone-text transition-transform duration-200 group-open:rotate-180"
              >
                <path d="M2 5l5 5 5-5" stroke="currentColor" stroke-width="1.25" />
              </svg>
            </summary>
            <p class="px-5 pb-5 text-sm leading-relaxed text-stone-text md:px-6">
              <Text text={item.answer} />
            </p>
          </details>
        ))
      }
    </div>
  </Container>
</section>
