---
import { Image } from "astro:assets";
import mapImage from "../assets/map.jpg";
import { studio } from "../content/studio";
import { interpolate, type Dictionary } from "../i18n";
import Container from "./ui/Container.astro";
import ExternalLink from "./ui/ExternalLink.astro";
import Text from "./ui/Text.astro";

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const { street, neighborhood, city, betweenStreets } = studio.address;
const between = betweenStreets ? interpolate(dict.location.between, { a: betweenStreets[0], b: betweenStreets[1] }) : null;
---

<section aria-labelledby="location-title" class="bg-bone py-20 md:py-28">
  <Container class="max-w-4xl">
    <h2 id="location-title" class="section-title">{dict.location.title}</h2>
    <!-- Mapa liviano: imagen estática + link a Google Maps, sin iframe ni scripts de terceros. -->
    <figure class="mt-10 overflow-hidden rounded-[1.25rem] border border-stone/45 bg-sand">
      <Image
        src={mapImage}
        alt={dict.location.mapAlt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 896px) 56rem, 100vw"
        class="aspect-[3/2] w-full object-cover md:aspect-[2/1]"
      />
      <figcaption class="flex flex-col gap-4 p-6 md:flex-row md:items-end md:justify-between md:p-8">
        <address class="not-italic">
          <span class="block text-[0.6875rem] font-semibold tracking-[0.2em] uppercase text-stone-text">
            {dict.location.addressLabel}
          </span>
          <span class="mt-2 block font-serif text-2xl leading-snug">
            <Text text={street} />
          </span>
          {between && <span class="block text-sm">{between}</span>}
          <span class="block text-sm text-stone-text">{neighborhood}, {city}</span>
        </address>
        <ExternalLink href={studio.links.googleMaps} newTabHint={dict.a11y.opensInNewTab} class="text-link text-sm font-semibold">
          {dict.location.openMap}
        </ExternalLink>
      </figcaption>
    </figure>
  </Container>
</section>
