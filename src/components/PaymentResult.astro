---
import "../styles/global.css";

/**
 * Páginas a las que vuelve el cliente desde Mercado Pago. No confirman nada por sí
 * mismas: la acreditación la hace el webhook, que es la única fuente confiable.
 */
interface Props {
  tone: "ok" | "pending" | "error";
  title: string;
  message: string;
}

const { tone, title, message } = Astro.props;
const colors = {
  ok: "border-olive/40 bg-olive/10",
  pending: "border-terracotta/40 bg-terracotta/10",
  error: "border-terracotta-deep/40 bg-terracotta-deep/10",
} as const;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Studio124</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="grid min-h-screen place-items-center bg-sand px-5 antialiased">
    <main class="w-full max-w-md rounded-2xl border border-stone/40 bg-bone p-7 text-center">
      <p class="font-serif text-2xl">Studio124</p>
      <h1 class="mt-5 font-serif text-3xl">{title}</h1>
      <p class:list={["mt-4 rounded-xl border px-4 py-3 text-sm", colors[tone]]}>{message}</p>
      <a
        href="/cuenta/"
        class="mt-6 inline-flex h-12 items-center justify-center rounded-full bg-ink px-6 text-sm font-semibold text-bone"
      >
        Ir a mi cuenta
      </a>
    </main>
  </body>
</html>
