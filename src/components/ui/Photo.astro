---
/**
 * Imagen del sitio: cuadrada o rectangular y de bordes redondeados, como pide el manual
 * de marca. Siempre optimizada por Astro (AVIF/WebP) y con `alt` obligatorio.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Proporción del recuadro. `auto` respeta la de la imagen. */
  ratio?: "square" | "portrait" | "tall" | "landscape" | "wide" | "auto";
  /** `eager` sólo para la imagen que se ve al abrir la página. */
  loading?: "eager" | "lazy";
  sizes?: string;
  class?: string;
}

const { src, alt, ratio = "landscape", loading = "lazy", sizes = "(min-width: 768px) 50vw, 100vw", class: className } = Astro.props;

const ratios = {
  square: "aspect-square",
  portrait: "aspect-[4/5]",
  tall: "aspect-[5/7]",
  landscape: "aspect-[4/3]",
  wide: "aspect-[16/9]",
  auto: "",
} as const;
---

<div class:list={["photo-frame", ratios[ratio], className]}>
  <Image src={src} alt={alt} loading={loading} sizes={sizes} widths={[480, 768, 1024, 1440]} class="h-full w-full object-cover" />
</div>
