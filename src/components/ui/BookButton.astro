---
/**
 * Botón principal de reserva. El manual de marca no tiene color de acento: es una píldora
 * neutra, sólida sobre fondo claro y traslúcida sobre foto.
 * Lleva a la app externa en la misma pestaña para no perder al visitante en mobile.
 */
import { PUBLIC_BOOKING_URL } from "astro:env/client";

interface Props {
  label: string;
  size?: "sm" | "md" | "lg";
  /** `on-photo` para los botones que van encima de una imagen. */
  tone?: "solid" | "on-photo";
  /** `plain` es la variante en caja baja del encabezado, como la muestra el mockup. */
  variant?: "label" | "plain";
  block?: boolean;
  class?: string;
}

const { label, size = "md", tone = "solid", variant = "label", block = false, class: className } = Astro.props;

const sizes = {
  sm: "h-10 px-4 text-[0.6875rem]",
  md: "h-12 px-6 text-xs",
  lg: "h-14 px-7 text-[0.8125rem]",
} as const;

const plainSizes = {
  sm: "h-11 px-5 text-sm",
  md: "h-12 px-6 text-base",
  lg: "h-14 px-8 text-lg",
} as const;
---

<a
  href={PUBLIC_BOOKING_URL}
  rel="noopener"
  class:list={[
    "pill",
    variant === "plain" ? "font-medium" : "font-semibold tracking-[0.14em] uppercase",
    tone === "on-photo" ? "pill-light" : "pill-solid",
    variant === "plain" ? plainSizes[size] : sizes[size],
    block && "w-full",
    className,
  ]}
>
  <span>{label}</span>
  <span aria-hidden="true" class="text-[1.2em] leading-none">&rarr;</span>
</a>
