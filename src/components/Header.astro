---
import type { Dictionary } from "../i18n";
import type { Locale } from "../i18n/locales";
import { localePath } from "../lib/urls";
import Logo from "./brand/Logo.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import BookButton from "./ui/BookButton.astro";
import Container from "./ui/Container.astro";

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
---

{/*
  Encabezado del mockup: logo sobre círculo traslúcido, el selector de idioma y el botón
  de reserva.
*/}
<header class="on-dark absolute inset-x-0 top-0 z-20 text-cream">
  <Container class="flex items-center justify-between gap-3 py-4 md:py-6">
    <a
      href={localePath(locale)}
      aria-label={dict.a11y.home}
      class="grid size-16 shrink-0 place-items-center rounded-full bg-cream/15 backdrop-blur-[2px] md:size-20"
    >
      <Logo variant="on-dark" class="h-11 w-auto md:h-14" />
    </a>
    <div class="flex items-center gap-2 md:gap-7">
      <LanguageSwitcher current={locale} label={dict.a11y.languageNav} />
      <BookButton label={dict.cta.bookShort} newTabHint={dict.a11y.opensInNewTab} variant="plain" tone="bright" class="hidden md:inline-flex" />
    </div>
  </Container>
</header>
