---
/**
 * Precios que el estudio carga en el panel (Catálogo → "Mostrar en la landing").
 *
 * La landing es estática, así que no se compilan: los pide el navegador a la API al abrir
 * la página. Así un cambio de precio se ve en minutos, sin volver a publicar el sitio.
 * Si la API no responde o no hay nada marcado, el bloque no aparece y queda el texto de
 * siempre ("escribinos por WhatsApp"): nunca se ve un precio viejo ni un hueco.
 */
import { PUBLIC_API_URL } from "astro:env/client";
import type { Dictionary } from "../i18n";
import { LOCALE_META, type Locale } from "../i18n/locales";

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
---

<div data-prices data-api={PUBLIC_API_URL} data-locale={LOCALE_META[locale].intl} data-labels={JSON.stringify(dict.prices)} hidden>
  <h3 class="eyebrow text-text">{dict.prices.title}</h3>
  <ul data-prices-list class="mt-3 border-t-2 border-cream text-[0.9375rem]" aria-live="polite"></ul>
</div>

<script>
  import { formatAmount, type Currency } from "../lib/money";

  interface Price {
    readonly kind: "trial" | "single" | "single_duo" | "pack" | "monthly";
    readonly classes: number;
    readonly validityDays: number;
    readonly priceMinor: number;
    readonly currency: Currency;
  }

  type Labels = Record<"title" | "single" | "trial" | "duo" | "classes" | "weeks" | "days", string>;

  const fill = (template: string, vars: Record<string, number>): string =>
    template.replace(/\{(\w+)\}/g, (match, key: string) => String(vars[key] ?? match));

  function describe(price: Price, labels: Labels): { name: string; detail: string | null } {
    if (price.kind === "single") return { name: labels.single, detail: null };
    if (price.kind === "trial") return { name: labels.trial, detail: null };
    if (price.kind === "single_duo") return { name: labels.duo, detail: null };
    const { validityDays: days } = price;
    const detail = days % 7 === 0 ? fill(labels.weeks, { weeks: days / 7 }) : fill(labels.days, { days });
    return { name: fill(labels.classes, { count: price.classes }), detail };
  }

  function row(price: Price, labels: Labels, locale: string): HTMLLIElement {
    const { name, detail } = describe(price, labels);
    const item = document.createElement("li");
    item.className = "flex items-baseline justify-between gap-4 border-b-2 border-cream py-2.5";
    const label = document.createElement("span");
    label.className = "font-semibold";
    label.textContent = name;
    if (detail) {
      const small = document.createElement("span");
      small.className = "block text-xs font-normal";
      small.textContent = detail;
      label.append(small);
    }
    const amount = document.createElement("span");
    amount.className = "shrink-0 font-semibold tabular-nums";
    amount.textContent = formatAmount(price.priceMinor, price.currency, locale);
    item.append(label, amount);
    return item;
  }

  async function load(root: HTMLElement): Promise<void> {
    const { api, locale = "es-AR", labels: rawLabels } = root.dataset;
    const list = root.querySelector("[data-prices-list]");
    if (!api || !rawLabels || !list) return;
    const response = await fetch(new URL("/api/public/prices", api), { headers: { Accept: "application/json" } });
    if (!response.ok) return;
    const { prices } = (await response.json()) as { prices: Price[] };
    if (prices.length === 0) return;
    const labels = JSON.parse(rawLabels) as Labels;
    list.replaceChildren(...prices.map((price) => row(price, labels, locale)));
    root.hidden = false;
  }

  // Sin red o sin API, el bloque sigue oculto: el texto de la sección ya invita a escribir.
  for (const root of document.querySelectorAll<HTMLElement>("[data-prices]")) void load(root).catch(() => undefined);
</script>
