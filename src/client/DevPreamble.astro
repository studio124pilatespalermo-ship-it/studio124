---
/**
 * Preámbulo de React Fast Refresh (`@vitejs/plugin-react`), sólo para `astro dev`.
 *
 * `client:only="react"` lo inyecta solo; al montar el panel y el portal con un script propio
 * (ver src/client/mount.ts, por la CSP de producción) hay que ponerlo a mano, si no el primer
 * componente con JSX que carga revienta con "can't detect preamble" y la página queda en blanco.
 *
 * `import.meta.env.DEV` lo saca del build de producción: nunca lo toca la CSP ni el chequeo
 * de scripts en línea (integrations/csp-guard.mjs).
 */
const preamble =
  'import { injectIntoGlobalHook } from "/@react-refresh";' +
  "injectIntoGlobalHook(window);" +
  "window.$RefreshReg$ = () => {};" +
  "window.$RefreshSig$ = () => (type) => type;";
---

{import.meta.env.DEV && <script type="module" set:html={preamble} />}
