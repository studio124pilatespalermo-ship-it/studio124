---
import "../../styles/global.css";

/**
 * Panel de administración. Es una aplicación de cliente para que la landing siga siendo un
 * sitio estático: acá no se renderiza nada en el servidor ni se filtra información al HTML.
 *
 * Se monta con un script propio (src/client/mount.ts) y no con `client:only`: ese modo deja
 * código de arranque en línea, y la CSP de producción (`script-src 'self'`) lo bloquea.
 */
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Panel · Studio124</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="bg-sand/50 antialiased">
    <div id="app"></div>
    <noscript>
      <p class="p-8 text-center">El panel necesita JavaScript para funcionar.</p>
    </noscript>
    <script>
      import { mount } from "../../client/mount";
      import AdminApp from "../../admin/AdminApp";

      mount(AdminApp);
    </script>
  </body>
</html>
