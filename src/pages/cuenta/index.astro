---
import "../../styles/global.css";
import DevPreamble from "../../client/DevPreamble.astro";

/**
 * Portal del cliente: sus clases, reservas y pagos. Aplicación de cliente, igual que /admin,
 * para que la landing siga siendo un sitio estático.
 *
 * Se monta con un script propio (src/client/mount.ts) y no con `client:only`: ese modo deja
 * código de arranque en línea, y la CSP de producción (`script-src 'self'`) lo bloquea.
 */
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Mi cuenta · Studio124</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="bg-sand/50 antialiased">
    <div id="app"></div>
    <noscript>
      <p class="p-8 text-center">Tu cuenta necesita JavaScript. Escribinos y reservamos tu clase.</p>
    </noscript>
    <DevPreamble />
    <script>
      import { mount } from "../../client/mount";
      import PortalApp from "../../portal/PortalApp";

      mount(PortalApp);
    </script>
  </body>
</html>
