---
import type { GetStaticPaths } from "astro";
import { PUBLIC_BOOKING_URL } from "astro:env/client";
import About from "../../components/About.astro";
import BookAndMembership from "../../components/BookAndMembership.astro";
import Experience from "../../components/Experience.astro";
import Faq from "../../components/Faq.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import Method from "../../components/Method.astro";
import MobileBookingBar from "../../components/MobileBookingBar.astro";
import Schedule from "../../components/Schedule.astro";
import Space from "../../components/Space.astro";
import { studio } from "../../content/studio";
import { getDictionary, interpolate } from "../../i18n";
import { LOCALES, type Locale } from "../../i18n/locales";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { resolveFaq, templateVars } from "../../lib/content";
import { buildJsonLd } from "../../lib/jsonld";
import { absoluteUrl, localePath } from "../../lib/urls";

export const getStaticPaths = (() => LOCALES.map((lang) => ({ params: { lang }, props: { lang } }))) satisfies GetStaticPaths;

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = getDictionary(lang);
const site = Astro.site;
if (!site) throw new Error("Falta `site` en astro.config.mjs");

const vars = templateVars(studio, lang);
const description = interpolate(dict.meta.description, vars);
const faq = resolveFaq(dict, studio, lang);
const jsonLd = buildJsonLd({
  studio,
  pageUrl: absoluteUrl(localePath(lang), site),
  siteUrl: absoluteUrl("/", site),
  imageUrl: absoluteUrl("/og-image.jpg", site),
  logoUrl: absoluteUrl("/logo.png", site),
  description,
  offerName: dict.method.title,
  bookingUrl: PUBLIC_BOOKING_URL,
  faq,
});
---

<BaseLayout
  locale={lang}
  title={dict.meta.title}
  description={description}
  ogImageAlt={dict.meta.ogImageAlt}
  jsonLd={jsonLd}
  hasBookingBar
>
  <a
    href="#contenido"
    class="sr-only z-50 rounded-full bg-ink px-5 py-3 text-sm text-cream focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
  >
    {dict.a11y.skipToContent}
  </a>
  <Header locale={lang} dict={dict} />
  <main id="contenido" tabindex="-1" class="outline-none">
    <Hero dict={dict} />
    <Space dict={dict} />
    <Experience dict={dict} body={dict.experience.body.map((text) => interpolate(text, vars))} />
    <About dict={dict} />
    <Method dict={dict} text={interpolate(dict.method.text, vars)} />
    <Schedule dict={dict} />
    <BookAndMembership locale={lang} dict={dict} membership={dict.membership.body.map((text) => interpolate(text, vars))} />
    <Faq dict={dict} items={faq} />
  </main>
  <Footer locale={lang} dict={dict} />
  <MobileBookingBar dict={dict} />
</BaseLayout>
