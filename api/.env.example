# Copiá a .env para desarrollo. En Railway, cargá las mismas variables en el servicio.
# Las credenciales de Mercado Pago y de emails NO van acá: se cargan desde
# /admin → Configuración → Credenciales y quedan cifradas en la base.

# Postgres. Vacía en desarrollo = base embebida en ./.data (no hace falta instalar nada).
# En Railway se completa sola al agregar el servicio de Postgres.
DATABASE_URL=

# Clave maestra para cifrar las credenciales guardadas (32 bytes en base64).
# Generar una con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si cambia, hay que volver a cargar las credenciales desde el panel.
APP_ENCRYPTION_KEY=

# Direcciones públicas. La API usa PUBLIC_API_URL para armar el webhook de Mercado Pago.
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_API_URL=http://localhost:3000

PORT=3000
NODE_ENV=development

# Ingreso de clientes con Google (opcional: sin esto no se ofrece el botón).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Token para disparar las tareas diarias desde un cron externo (vencimientos y avisos).
CRON_SECRET=
